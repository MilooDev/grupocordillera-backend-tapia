            "type": "java",
            "name": "EurekaServerApplication",
            "request": "launch",
            "mainClass": "com.grupocordillera.eureka_server.EurekaServerApplication",
            "projectName": "eureka_server",
            "vmArgs": " -Dcom.sun.management.jmxremote -Dcom.sun.management.jmxremote.port=61559 -Dcom.sun.management.jmxremote.authenticate=false -Dcom.sun.management.jmxremote.ssl=false -Dspring.jmx.enabled=true -Djava.rmi.server.hostname=localhost -Dspring.application.admin.enabled=true -Dspring.boot.project.name=eureka_server"
        },
